# ==================================================
# TaskFlow Backend — Environment Variables (EXAMPLE)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==================================================

# --- Database (PostgreSQL) ---
# Use a dedicated, non-superuser database role in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/taskflow_db?schema=public"

# --- Server ---
PORT=5000
# development | production | test
NODE_ENV=development

# --- JWT Authentication ---
# Generate a strong secret (>=32 chars), e.g.:  openssl rand -hex 32
# The server refuses to start in production with a weak/default secret.
JWT_SECRET="CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# --- CORS ---
# Comma-separated allowlist of browser origins. Do NOT use "*" in production.
# Example: https://app.taskflow.com,https://admin.taskflow.com
# Leave blank in development to use sensible localhost defaults.
CLIENT_URL="https://your-production-frontend.example.com"

# Allow requests with no Origin header (native mobile apps, curl, Postman).
# Set to "false" to reject them.
ALLOW_NO_ORIGIN=true
